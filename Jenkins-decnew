pipeline {
    agent any

    options {
        durabilityHint('MAX_SURVIVABILITY')
    }

    stages {

        stage('Git Checkout') {
            steps {
                git branch: 'master',
                credentialsId: 'javahome2',
                url: 'https://github.com/Vijaya2302/myweb.git'
            }
        }

        stage('Maven Build') {
            steps {
                sh 'mvn clean package'
                sh 'mv target/myweb-8.2.0.war target/myweb.war'
            }
        }

        stage('Deploy') {
            steps {
                sshagent(['ubuntu']) {
                    sh '''
                    scp -o StrictHostKeyChecking=no \
                    target/myweb.war \
                    ubuntu@172.31.43.127:/home/ubuntu/apache-tomcat-9.0.64/webapps/
                    '''
                }
            }
        }
    }
}
}
