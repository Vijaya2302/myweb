pipeline{
    agent any
    
    environment{
        PATH = "/opt/maven3/bin:$PATH"
    }
    stages{
        stage("Git Checkout"){
            steps{
               git credentialsId: 'javahome2', url: 'https://github.com/Vijaya2302/myweb.git'
            }
        }
        stage("Maven Build"){
            steps{
                sh "mvn clean package"
                sh "mv target/*.war target/myweb.war"
            }
        }
        stage('deploy-dev') {
    steps {
        sshagent(['ubuntu']) {
            sh '''
            scp -o StrictHostKeyChecking=no \
            target/myweb.war \
            ubuntu@172.31.43.127:/opt/tomcat/webapps/
            '''
        }
    }
}
        
    }
}
