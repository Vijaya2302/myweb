pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        durabilityHint('PERFORMANCE_OPTIMIZED')
    }

    environment {
        PATH = "/opt/maven3/bin:$PATH"
    }

    stages {

        stage('Git Checkout') {
            steps {
                git credentialsId: 'javahome2',
                    url: 'https://github.com/Vijaya2302/myweb.git'
            }
        }

        stage('Maven Build') {
            steps {
                sh 'mvn clean package -DskipTests'
                sh 'mv target/*.war target/myweb.war'
            }
        }

        stage('Deploy') {
            steps {
                sshagent(['ubuntu']) {
                    sh '''
                    scp -o StrictHostKeyChecking=no \
                    target/myweb.war \
                    ubuntu@172.31.43.127:/home/ubuntu/apache-tomcat-9.0.64/webapps/
                    '''
                }
            }
        }
    }
}
